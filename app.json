{
  "expo": {
    "name": "ToyOlsun",
    "slug": "ToyOlsun",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toyolsun",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibo96.ToyOlsun",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "package": "com.ibo96.ToyOlsun"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2C2623"
        }
      ],
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "toy-olsun"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2633964793790634",
          "displayName": "ToyOlsun",
          "scheme": "fb2633964793790634",
          "isAutoInitEnabled": false,
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": true,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Bu icazə sizə daha uyğun ToyOlsun reklamları göstərmək üçün istifadə olunur."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "305617bc-b0ce-49cd-8c96-b80bab6a7b65"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/305617bc-b0ce-49cd-8c96-b80bab6a7b65"
    }
  }
}
